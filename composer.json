{
    "name": "finlayjn/static-site-deployer",
    "description": "Triggers a Simply Static export on save (or on demand) and deploys the result to Cloudflare Workers static assets.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "0.1.0",
    "autoload": {
        "psr-4": {
            "SSD\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Finlay Nathan",
            "email": "52335224+finlayjn@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "symfony/mime": "^7.3"
    },
    "require-dev": {
        "johnpbloch/wordpress-core": "^6.8",
        "simplystatic/simply-static": "^3.3"
    }
}
